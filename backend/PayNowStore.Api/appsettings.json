    "ReturnUrl": "http://localhost:5173/payment/return",
    "ResultUrl": "https://your-api-host/api/payments/callback"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:4173",
      "https://localhost:4173"
    ]
  },
  "AllowedHosts": "*"
