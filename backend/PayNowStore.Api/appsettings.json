{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=paynowstore;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "PayNowStore",
    "Audience": "PayNowStoreClient",
    "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY"
  },
  "Paynow": {
    "IntegrationId": "YOUR_PAYNOW_INTEGRATION_ID",
